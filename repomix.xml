      gap: 10px;
    }

    .toast-notification.show {
      transform: translateY(0);
    }

    /* SVG Pixel Icons inside styling */
    .pixel-icon {
      image-rendering: pixelated;
    }
    .icon-blood { fill: var(--accent-red); }
    .icon-fire { fill: var(--accent-red); }
    .icon-candle { fill: var(--text-main); }
    .icon-star { fill: var(--accent-gold-glow); }

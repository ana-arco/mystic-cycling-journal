<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grimorio del Ciclo Místico y Lunar</title>
  <!-- Google Fonts for Pixel Art & Medieval vibes -->

    // Calcular la fase lunar calibrada para 2026 (Anclada al Lunes 15 de Junio de 2026 como Luna Nueva 0%)
    function obtenerDatosLunares(fecha) {
      const fechaReferencia = new Date(2026, 5, 15, 20, 0, 0); // 15 de Junio de 2026 (Mes indexado 5)
      const longitudCiclo = 29.530588853; // Duración media del mes sinódico

      const diffTiempo = fecha - fechaReferencia;
      const diffDias = diffTiempo / (1000 * 60 * 60 * 24);

      let diasCiclo = diffDias % longitudCiclo;
      if (diasCiclo < 0) diasCiclo += longitudCiclo;

      // Calcular porcentaje de iluminación exacto
      let iluminacion = (1 - Math.abs((diasCiclo / 14.7652944) - 1)) * 100;
      if (iluminacion < 0) iluminacion = 0;
      if (iluminacion > 100) iluminacion = 100;

      // Determinar fase visual
      let faseNombre = "";
      let icono = "";
      if (diasCiclo < 1.0 || diasCiclo >= 28.53) { faseNombre = "Nueva"; icono = "🌑"; }
      else if (diasCiclo < 6.38) { faseNombre = "Creciente Iluminada"; icono = "🌒"; }
      else if (diasCiclo < 8.38) { faseNombre = "Cuarto Creciente"; icono = "🌓"; }
      else if (diasCiclo < 13.76) { faseNombre = "Gibosa Creciente"; icono = "🌔"; }
      else if (diasCiclo < 15.76) { faseNombre = "Llena"; icono = "🌕"; }
      else if (diasCiclo < 21.14) { faseNombre = "Gibosa Menguante"; icono = "🌖"; }
      else if (diasCiclo < 23.14) { faseNombre = "Cuarto Menguante"; icono = "🌗"; }
      else { faseNombre = "Creciente Menguante"; icono = "🌘"; }

      const mes = fecha.getMonth() + 1;
      const dia = fecha.getDate();

      const lunasLlenasDelAño = [
        { nombre: "Luna de Lobo", icono: "🐺" },
        { nombre: "Luna de Nieve", icono: "❄️" },
        { nombre: "Luna de Gusano", icono: "🪱" },
        { nombre: "Luna Rosa", icono: "🌸" },
        { nombre: "Luna de Flores", icono: "💐" },
        { nombre: "Luna de Fresa", icono: "🍓" },
        { nombre: "Luna de Ciervo", icono: "🦌" },
        { nombre: "Luna de Esturión", icono: "🐟" },
        { nombre: "Luna de Cosecha", icono: "🌾" },
        { nombre: "Luna del Cazador", icono: "🏹" },
        { nombre: "Luna del Castor", icono: "🦫" },
        { nombre: "Luna Fría", icono: "🥶" }
      ];

      let lunaActual = lunasLlenasDelAño[mes - 1];
      let nombreLunaDelAño = lunaActual.nombre;
      let iconoLunaDelAño = lunaActual.icono;

      if (faseNombre === "Llena" && dia >= 30) {
        nombreLunaDelAño = "Luna Azul (Mística)";
        iconoLunaDelAño = "🌌";
      }

      return {
        porcentaje: iluminacion.toFixed(1),
        fase: faseNombre,
        icono: icono,
        nombreAnual: nombreLunaDelAño,
        iconoAnual: iconoLunaDelAño
      };
    }


    // Algoritmo matemático para dibujar el sprite SVG de la Luna en 16x16
    function generateMoonSvg(phaseIndex, lightColor = 'var(--accent-gold-glow)', shadowColor = 'var(--bg-book)') {
      let illuminatedPart = '';

      if (phaseIndex === 0) { // Luna Nueva
        illuminatedPart = '';
      } else if (phaseIndex === 1) { // Creciente Cóncava
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 A 3 7 0 0 1 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 2) { // Cuarto Creciente
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 3) { // Creciente Gibbosa
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 A 3 7 0 0 0 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 4) { // Luna Llena
        illuminatedPart = `<circle cx="8" cy="8" r="7" fill="${lightColor}"/>`;
      } else if (phaseIndex === 5) { // Menguante Gibbosa
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 A 3 7 0 0 1 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 6) { // Cuarto Menguante
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 7) { // Menguante Cóncava
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 A 3 7 0 0 0 8 1 Z" fill="${lightColor}"/>`;
      }

      return `
        <svg viewBox="0 0 16 16" width="100%" height="100%" class="pixel-icon">
          <circle cx="8" cy="8" r="7" fill="${shadowColor}" opacity="0.45"/>
          ${illuminatedPart}
        </svg>
      `;
    }


    /* ----------------------------------------------------
       Lógica de Pintura y Arrastre (Drag and Paint)
       ---------------------------------------------------- */
    function handleCellMouseDown(cellNum, e) {
      e.preventDefault();
      isDrawing = true;
      audio.playClick();
      selectedFreeDay = cellNum;

      // Aplicar el estado de la herramienta
      applyToolToCell(cellNum);

      // Volver a renderizar para ver seleccionados y cambios
      renderFreeView(document.getElementById('left-page-content'));
    }

    function handleCellMouseEnter(cellNum) {
      if (isDrawing) {
        applyToolToCell(cellNum);
        renderFreeView(document.getElementById('left-page-content'));
      }
    }

    function applyToolToCell(cellNum) {
      if (!savedFreeGrid[cellNum]) {
        savedFreeGrid[cellNum] = { blood: false, fire: false, candle: false, star: false };
      }

      if (activeTool === 'broom') {
        // Borrar todo
        savedFreeGrid[cellNum] = { blood: false, fire: false, candle: false, star: false };
      } else {
        // Alternar el estado seleccionado
        savedFreeGrid[cellNum][activeTool] = !savedFreeGrid[cellNum][activeTool];
      }

      // Guardar en almacenamiento local
      localStorage.setItem('savedFreeGrid', JSON.stringify(savedFreeGrid));
    }

    /* ----------------------------------------------------
       Selección de Elementos de los Calendarios
       ---------------------------------------------------- */
    function selectSabbat(id) {
      audio.playShimmer();
      selectedSabbat = id;

      // Actualizar vista izquierda para marcar el seleccionado
      renderStationsView(document.getElementById('left-page-content'));
    }

    function selectCycleDay(dayNum) {
      audio.playClick();
      selectedCycleDay = dayNum;
      renderCycle28View(document.getElementById('left-page-content'));
    }

    function selectLunarDay(dayNum) {
      audio.playClick();
      selectedLunarDay = dayNum;
      renderMoonView(document.getElementById('left-page-content'));
    }

    /* ----------------------------------------------------
       Actualización del Diario de la Derecha
       ---------------------------------------------------- */

    // Diario para Vista 1: Sabbat
    function updateJournalForSabbat(id) {
      const data = sabbatsData.find(s => s.id === id);
      document.getElementById('journal-title').innerText = `${data.symbol} Sabbat: ${data.name}`;

      const contentArea = document.getElementById('journal-content-area');
      contentArea.innerHTML = `
        <div class="journal-section">
          <div class="section-title">Festividad e Hito</div>
          <div class="journal-body"><strong>${data.title}</strong> (${data.date})</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Energía del Momento</div>
          <div class="journal-body"><em>${data.energy}</em></div>
        </div>
        <div class="journal-section">
          <div class="section-title">Correspondencia Elemental</div>
          <div class="journal-body">${data.element}</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Sabiduría Ancestral</div>
          <div class="journal-body">${data.description}</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Ritual Sugerido</div>
          <div class="journal-body" style="border-left: 2px solid var(--accent-gold); padding-left: 8px;">
            ${data.ritual}
          </div>
        </div>
      `;

      // Ocultar formulario de notas
      document.getElementById('notes-form').style.display = 'none';
    }

    // Diario para Vista 2: Ciclo Menstrual
    function updateJournalForCycleDay(dayNum) {
      const phase = cyclePhases.find(p => dayNum >= p.range[0] && dayNum <= p.range[1]);
      document.getElementById('journal-title').innerText = `Día ${dayNum}: ${phase.name}`;

      // Niveles simulados de energía por fase para hacerlo interactivo
      let energyHeart = '💖💖💖💖';
      let socialState = 'Normal';
      if (phase.name === 'Menstruación') { energyHeart = '💖'; socialState = 'Ermitaña/Introspección'; }
      if (phase.name === 'Fase Folicular') { energyHeart = '💖💖💖'; socialState = 'Enérgica/Social'; }
      if (phase.name === 'Fase Ovulatoria') { energyHeart = '💖💖💖💖💖'; socialState = 'Radiante/Seductora'; }
      if (phase.name === 'Fase Lútea') { energyHeart = '💖💖'; socialState = 'Intuitiva/Selectiva'; }

      const contentArea = document.getElementById('journal-content-area');
      contentArea.innerHTML = `
        <div class="journal-section">
          <div class="section-title">Arquetipo Femenino</div>
          <div class="journal-body"><strong>${phase.archetype}</strong></div>
        </div>
        <div class="journal-section">
          <div class="section-title">Vibración e Influencia</div>
          <div class="journal-body">${phase.description}</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Guía de Autocuidado</div>
          <div class="journal-body" style="border-left: 2px solid ${phase.color}; padding-left: 8px;">
            ${phase.guidance}
          </div>
        </div>
        <div class="journal-section">
          <div class="section-title">Nivel de Energía Vital</div>
          <div class="journal-body">${energyHeart}</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Disposición Social</div>
          <div class="journal-body">${socialState}</div>
        </div>
      `;

      // Ocultar formulario de notas
      document.getElementById('notes-form').style.display = 'none';
    }

    // Diario para Vista 3: Día Lunar
    function updateJournalForLunarDay(dayNum) {
      const phasePercentage = ((dayNum - 1) % 29.5) / 29.5;
      const phaseIndex = Math.floor(phasePercentage * 8);

      const lunarPhasesNames = [
        "Luna Nueva (Fase de Oscuridad)",
        "Luna Creciente Cóncava",
        "Cuarto Creciente",
        "Luna Creciente Gibbosa",
        "Luna Llena (Plenitud Absoluta)",
        "Luna Menguante Gibbosa (Diseminadora)",
        "Cuarto Menguante",
        "Luna Menguante Cóncava (Balsámica)"
      ];

      const phaseName = lunarPhasesNames[phaseIndex];
      document.getElementById('journal-title').innerText = `Día Lunar ${dayNum}`;

      // Interpretaciones místicas simuladas basadas en fases arquetípicas
      let energyDesc = '';
      let crystalRitual = '';

      if (phaseIndex === 0) {
        energyDesc = "Fase para sembrar intenciones en el vacío. Excelente para descansar y conectar con la introspección profunda. La oscuridad es un útero de potencial puro.";
        crystalRitual = "Carga piedras negras de protección (turmalina, obsidiana) y escribe una lista de intenciones de lo que manifestarás en este ciclo.";
      } else if (phaseIndex > 0 && phaseIndex < 4) {
        energyDesc = "Fase de crecimiento e impulso. La luz crece día a día. Es momento de tomar acciones firmes, regar tus proyectos y superar la inercia.";
        crystalRitual = "Lleva contigo cristales de cuarzo verde o aventurina para estimular la prosperidad y el éxito de tus esfuerzos.";
      } else if (phaseIndex === 4) {
        energyDesc = "El clímax de la lunación. Energía expansiva, mágica y creativa desbordante. Tus emociones se magnifican bajo el brillo de la luz lunar total.";
        crystalRitual = "Carga tus cristales (sobre todo piedra de luna, amatista y cuarzo blanco) bajo la luz de la luna llena toda la noche. Prepara agua de luna.";
      } else {
        energyDesc = "Fase de limpieza, entrega y desapego. La luz decrece. Es momento de desintoxicar el cuerpo, limpiar tus espacios y soltar lo que ya no sirve.";
        crystalRitual = "Limpia tus cristales físicamente y pásalos por el humo de un sahumerio de salvia o copal para purificar su energía.";
      }

      const contentArea = document.getElementById('journal-content-area');
      contentArea.innerHTML = `
        <div class="journal-section">
          <div class="section-title">Fase Astronómica Dominante</div>
          <div class="journal-body"><strong>${phaseName}</strong></div>
        </div>
        <div class="journal-section" style="margin: 10px 0; text-align: center;">
          <div style="width: 50px; height: 50px; margin: 0 auto;">
            ${generateMoonSvg(phaseIndex, 'var(--accent-gold-glow)', 'var(--bg-book)')}
          </div>
        </div>
        <div class="journal-section">
          <div class="section-title">Influencia Mística</div>
          <div class="journal-body">${energyDesc}</div>
        </div>
        <div class="journal-section">
          <div class="section-title">Ritual con Cristales</div>
          <div class="journal-body" style="border-left: 2px solid var(--accent-gold-glow); padding-left: 8px;">
            ${crystalRitual}
          </div>
        </div>
      `;

      // Ocultar formulario de notas
      document.getElementById('notes-form').style.display = 'none';
    }

    // Diario para Vista 4: Selección Libre e Inyección del Editor de Notas
    function updateJournalForFreeDay(dayNum) {
      document.getElementById('journal-title').innerText = `Registro Diario: Día ${dayNum}`;

      const cellData = savedFreeGrid[dayNum] || {};
      let statuses = [];

      if (cellData.blood) statuses.push(`<span class="stat-badge">🩸 Sangrado</span>`);
      if (cellData.fire) statuses.push(`<span class="stat-badge">🔥 Cólicos</span>`);
      if (cellData.candle) statuses.push(`<span class="stat-badge">🕯️ Ritual</span>`);
      if (cellData.star) statuses.push(`<span class="stat-badge">🌟 Energía Alta</span>`);

      const textNotes = savedNotes[`day_${dayNum}`] || "";

      const contentArea = document.getElementById('journal-content-area');
      contentArea.innerHTML = `
        <div class="journal-section">
          <div class="section-title">Estados Registrados</div>
          <div class="journal-stats">
            ${statuses.length > 0 ? statuses.join(' ') : '<span style="color: var(--text-muted);">Sin estados registrados hoy. Usa la paleta de pinceles de la izquierda para marcar eventos.</span>'}
          </div>
        </div>
        
        <div class="journal-section" style="margin-top: 15px;">
          <div class="section-title">Notas Guardadas en Grimorio</div>
          <div class="journal-body" style="background: var(--bg-book); padding: 8px; border: 1px dashed var(--border-color); white-space: pre-wrap; min-height: 50px;">${textNotes ? textNotes : '<span style="color: var(--text-muted); font-style: italic;">No hay apuntes para este día. Escribe en el Diario de Sombras abajo para dejar constancia.</span>'}</div>
        </div>
      `;

      // Mostrar el formulario para editar notas
      const notesForm = document.getElementById('notes-form');
      notesForm.style.display = 'flex';

      const notesInput = document.getElementById('shadow-notes-input');
      notesInput.value = textNotes;
    }

    /* ----------------------------------------------------
       Guardado de Notas en localStorage
       ---------------------------------------------------- */
    function saveNotes(e) {
      e.preventDefault();

      if (currentView !== 'free') return;

      const noteContent = document.getElementById('shadow-notes-input').value;
      savedNotes[`day_${selectedFreeDay}`] = noteContent;

      localStorage.setItem('savedNotes', JSON.stringify(savedNotes));

      // Reproducir sonido exitoso
      audio.playSuccess();

      // Mostrar Toast Retro
      showToast("Notas guardadas en Grimorio");

      // Actualizar diario
      updateJournalForFreeDay(selectedFreeDay);
    }

    /* ----------------------------------------------------
       Notificaciones Retro (Toast)
       ---------------------------------------------------- */
    function showToast(text) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-text').innerText = text.toUpperCase();

      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2000);
    }

    /* ----------------------------------------------------
       Limpiar Todo el Historial
       ---------------------------------------------------- */
    function clearAllData() {
      if (confirm("¿Estás segura de querer borrar todas las notas y registros de tu Grimorio? Esta acción no se puede deshacer.")) {
        savedFreeGrid = {};
        savedNotes = {};
        localStorage.removeItem('savedFreeGrid');
        localStorage.removeItem('savedNotes');

        audio.playSuccess();
        showToast("Grimorio purificado");

        // Volver a renderizar la vista actual
        if (currentView === 'free') {
          renderFreeView(document.getElementById('left-page-content'));
        }
      }
    }

    /* ----------------------------------------------------
       Inicialización de la Aplicación
       ---------------------------------------------------- */
    window.addEventListener('DOMContentLoaded', () => {
      // Cargar vista de lunación por defecto
      renderMoonView(document.getElementById('left-page-content'));
    });
  </script>
</body>

</html>

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grimorio del Ciclo Místico y Lunar</title>
  <link rel="icon"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' width='16' height='16' style='image-rendering:pixelated'%3E%3Crect x='2' y='1' width='12' height='14' fill='%23382216' stroke='%231b0f0a' stroke-width='1'/%3E%3Crect x='1' y='3' width='2' height='2' fill='%237c8389'/%3E%3Crect x='1' y='7' width='2' height='2' fill='%237c8389'/%3E%3Crect x='1' y='11' width='2' height='2' fill='%237c8389'/%3E%3Crect x='7' y='6' width='3' height='3' fill='%23d4af37'/%3E%3Crect x='8' y='7' width='1' height='1' fill='%23ffee7d'/%3E%3C/svg%3E">

  <!-- Google Fonts for Pixel Art & Medieval vibes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Press+Start+2P&family=VT323&display=swap"
    rel="stylesheet">

  <style>
    /* ==========================================
       1. VARIABLES Y SISTEMA DE TEMAS (CSS VARIABLES)
       ========================================== */
    :root {
      /* Tema por defecto: Pergamino Cozy */
      --bg-page: #d4c5a1;
      /* Fondo cálido madera/mesa */
      --bg-book: #f4eccf;
      /* Pergamino claro */
      --bg-darker: #e2d7b2;
      /* Pergamino sombreado */
      --text-main: #3c2a1a;
      /* Marrón oscuro cuero */
      --text-muted: #7d5c41;
      /* Marrón medio */
      --border-color: #2e1d11;
      /* Borde oscuro pixel */

      --accent-gold: #b3861b;
      --accent-gold-glow: #ffd700;
      --accent-red: #a32e2e;
      --accent-green: #3b7e46;
      --accent-purple: #5c2d7a;

      --shadow-color: rgba(46, 29, 17, 0.25);

      /* Animaciones */
      --retro-transition: all 0.15s steps(4);
    }

    [data-theme="stone"] {
      /* Tema Alternativo: Piedra Arcana Nocturna */
      --bg-page: #0f0a18;
      /* Espacio exterior / calabozo oscuro */
      --bg-book: #1f182c;
      /* Piedra oscura */
      --bg-darker: #150f1f;
      /* Huecos oscuros */
      --text-main: #e6dbf3;
      /* Lilac luminoso */
      --text-muted: #8d79a5;
      /* Morado apagado */
      --border-color: #45355c;
      /* Borde runa */

      --accent-gold: #f4be37;
      --accent-gold-glow: #ffee7d;
      --accent-red: #f34b4b;
      --accent-green: #4ade80;
      --accent-purple: #a855f7;

      --shadow-color: rgba(0, 0, 0, 0.6);
    }

    /* ==========================================
       2. REGLAS GENERALES Y RESET
       ========================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      image-rendering: pixelated;
    }

    body {
      background-color: var(--bg-page);
      font-family: 'VT323', monospace;
      color: var(--text-main);
      font-size: 20px;
      line-height: 1.4;
      padding: 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      overflow-x: hidden;
      transition: background-color 0.4s ease;
      background-image: radial-gradient(var(--border-color) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    [data-theme="stone"] body {
      background-image: radial-gradient(var(--accent-purple) 1px, transparent 1px);
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      letter-spacing: 1px;
    }

    /* ==========================================
       3. DISEÑO PIXEL ART UTILS
       ========================================== */
    .pixel-border-4 {
      border: 4px solid var(--border-color);
      box-shadow:
        0 4px 0 -4px var(--bg-book),
        4px 0 0 -4px var(--bg-book),
        -4px 0 0 -4px var(--bg-book),
        0 -4px 0 -4px var(--bg-book),
        4px 4px 0 0 var(--border-color),
        -4px -4px 0 0 var(--border-color),
        4px -4px 0 0 var(--border-color),
        -4px 4px 0 0 var(--border-color);
    }

    .pixel-btn {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: var(--text-main);
      background-color: var(--bg-darker);
      border: 4px solid var(--border-color);
      padding: 8px 12px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      outline: none;
      position: relative;
      user-select: none;
      margin-bottom: 4px;
    }

    .pixel-btn:active {
      transform: translateY(2px);
      background-color: var(--bg-book);
    }

    .pixel-btn.active {
      background-color: var(--accent-gold);
      color: var(--bg-page);
    }

    /* ==========================================
       4. CABECERA & CONTROLES
       ========================================== */
    header {
      width: 100%;
      max-width: 1024px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
    }

    .header-title {
      font-size: 38px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-shadow: 2px 2px 0 var(--shadow-color);
    }

    .header-subtitle {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: var(--text-muted);
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .controls-row {
      display: flex;
      gap: 12px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    /* ==========================================
       5. EL GRIMORIO / LIBRO PRINCIPAL
       ========================================== */
    .grimoire-container {
      width: 100%;
      max-width: 1024px;
      display: flex;
      flex-direction: column;
      position: relative;
      margin-top: 10px;
    }

    /* Pestañas (Marcadores del Libro) */
    .grimoire-tabs {
      display: flex;
      flex-wrap: wrap;
      z-index: 5;
      padding-left: 20px;
      gap: 4px;
    }

    .grimoire-tab {
      font-family: 'Press Start 2P', monospace;
      font-size: 9px;
      background-color: var(--bg-darker);
      border: 4px solid var(--border-color);
      border-bottom: none;
      padding: 10px 14px;
      cursor: pointer;
      color: var(--text-muted);
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
      transition: transform 0.1s steps(2);
      transform: translateY(4px);
    }

    .grimoire-tab:hover {
      color: var(--text-main);
      transform: translateY(2px);
    }

    .grimoire-tab.active {
      background-color: var(--bg-book);
      color: var(--text-main);
      transform: translateY(0);
      font-weight: bold;
      border-bottom: 4px solid var(--bg-book);
      padding-bottom: 12px;
    }

    /* El Libro Abierto */
    .grimoire-book {
      background-color: var(--bg-book);
      border: 6px solid var(--border-color);
      box-shadow: 0 10px 0 var(--shadow-color);
      display: grid;
      grid-template-columns: 1fr 4px 1fr;
      min-height: 580px;
      position: relative;
      border-radius: 4px;
      z-index: 1;
    }

    @media (max-width: 768px) {
      .grimoire-book {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
      }

      .grimoire-spine {
        height: 6px !important;
        width: 100% !important;
        background-color: var(--border-color);
      }
    }

    /* Páginas */
    .grimoire-page {
      padding: 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Lomo Central del Libro */
    .grimoire-spine {
      background-color: var(--border-color);
      height: 100%;
      width: 4px;
      position: relative;
    }

    .grimoire-spine::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -8px;
      width: 8px;
      background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.15));
    }

    .grimoire-spine::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: -8px;
      width: 8px;
      background: linear-gradient(to left, transparent, rgba(0, 0, 0, 0.15));
    }

    .page-title {
      font-size: 26px;
      margin-bottom: 16px;
      border-bottom: 2px dashed var(--border-color);
      padding-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--accent-gold);
    }

    .page-content-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    /* ==========================================
       6. VISTA 1: RUEDA DE LAS ESTACIONES
       ========================================== */
    .wheel-container {
      position: relative;
      width: 100%;
      max-width: 340px;
      aspect-ratio: 1;
    }

    .wheel-svg {
      width: 100%;
      height: 100%;
    }

    .sabbat-node {
      cursor: pointer;
      transition: var(--retro-transition);
    }

    .sabbat-node circle {
      stroke: var(--border-color);
      stroke-width: 1.5;
      transition: var(--retro-transition);
    }

    .sabbat-node:hover circle {
      r: 14;
      stroke: var(--accent-gold-glow);
      stroke-width: 2.5;
      filter: drop-shadow(0 0 4px var(--accent-gold-glow));
    }

    .sabbat-node.selected circle {
      r: 15;
      stroke: var(--accent-gold-glow);
      stroke-width: 3;
      fill: var(--text-main);
    }

    .sabbat-node text {
      font-family: 'Press Start 2P', monospace;
      font-size: 6px;
      fill: var(--text-main);
      pointer-events: none;
      text-anchor: middle;
    }

    .wheel-center-txt {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      fill: var(--text-muted);
      text-anchor: middle;
      pointer-events: none;
    }

    /* ==========================================
       7. VISTA 2: ANILLO DE 28 DÍAS (MENSTRUAL)
       ========================================== */
    .ring-container {
      position: relative;
      width: 100%;
      max-width: 320px;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ring-bead {
      cursor: pointer;
      transition: var(--retro-transition);
    }

    .ring-bead:hover {
      filter: brightness(1.3) drop-shadow(0 0 3px var(--accent-gold-glow));
      transform: scale(1.15);
    }

    .ring-bead.selected {
      stroke: var(--accent-gold-glow);
      stroke-width: 3;
      stroke-dasharray: none;
      filter: drop-shadow(0 0 5px var(--accent-gold-glow));
    }

    .ring-center-panel {
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: var(--bg-darker);
      border: 3px solid var(--border-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px;
      box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.1);
      pointer-events: none;
    }

    .ring-center-day {
      font-family: 'Press Start 2P', monospace;
      font-size: 11px;
      margin-bottom: 2px;
      color: var(--text-main);
    }

    .ring-center-phase {
      font-size: 15px;
      color: var(--text-muted);
      line-height: 1.1;
      font-weight: bold;
    }

    .phase-color-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin-top: 14px;
      width: 100%;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border: 2px solid var(--border-color);
      border-radius: 50%;
    }

    /* ==========================================
       8. VISTA 3: CALENDARIO DE LA LUNA
       ========================================== */
    .almanaque-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      width: 100%;
      max-width: 380px;
    }

    .almanaque-dia-card {
      background: var(--bg-darker);
      border: 2px solid var(--border-color);
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 4px;
      cursor: pointer;
      transition: var(--retro-transition);
      position: relative;
    }

    .almanaque-dia-card:hover {
      background: var(--bg-book);
      border-color: var(--accent-gold-glow);
      transform: translateY(-2px);
    }

    .almanaque-dia-card.selected {
      border-color: var(--accent-gold);
      box-shadow: 0 0 0 2px var(--accent-gold-glow);
      background: var(--bg-book);
    }

    .almanaque-dia-vacio {
      aspect-ratio: 1;
      visibility: hidden;
    }

    .almanaque-dia-num {
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      color: var(--text-muted);
      align-self: flex-start;
    }

    .almanaque-luna-icon {
      font-size: 18px;
      margin: auto 0;
      line-height: 1;
    }

    .lunar-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      width: 100%;
      max-width: 380px;
    }

    .lunar-day-card {
      background: var(--bg-darker);
      border: 2px solid var(--border-color);
      aspect-ratio: 0.9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 4px;
      cursor: pointer;
      transition: var(--retro-transition);
    }

    .lunar-day-card:hover {
      background: var(--bg-book);
      border-color: var(--accent-gold-glow);
      transform: translateY(-2px);
    }

    .lunar-day-card.selected {
      border-color: var(--accent-gold);
      box-shadow: 0 0 0 2px var(--accent-gold-glow);
      background: var(--bg-book);
    }

    .lunar-day-num {
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: var(--text-muted);
    }

    .lunar-day-icon {
      width: 24px;
      height: 24px;
    }

    .lunar-day-card.major-phase {
      border: 2px double var(--accent-gold);
      background: linear-gradient(135deg, var(--bg-darker), rgba(255, 215, 0, 0.05));
    }

    /* ==========================================
       9. VISTA 4: SELECCIÓN LIBRE (PAINT GRID)
       ========================================== */
    .free-selection-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 420px;
    }

    .toolbox {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tool-btn {
      width: 38px;
      height: 38px;
      border: 3px solid var(--border-color);
      background: var(--bg-darker);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--retro-transition);
      position: relative;
    }

    .tool-btn:hover {
      background: var(--bg-book);
      transform: translateY(-2px);
    }

    .tool-btn.active {
      background: var(--accent-gold);
      border-color: var(--accent-gold-glow);
      box-shadow: 0 0 6px var(--accent-gold-glow);
    }

    .tool-btn svg {
      width: 20px;
      height: 20px;
      fill: var(--text-main);
    }

    .tool-btn.active svg {
      fill: var(--bg-page);
    }

    .paint-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      width: 100%;
      user-select: none;
    }

    .grid-cell {
      background: var(--bg-darker);
      border: 2px solid var(--border-color);
      aspect-ratio: 1;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 3px;
      position: relative;
      transition: var(--retro-transition);
    }

    .grid-cell:hover {
      background: var(--bg-book);
      border-color: var(--accent-gold);
    }

    .grid-cell.selected {
      background: var(--bg-book);
      outline: 2px solid var(--accent-gold-glow);
    }

    .cell-number {
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: var(--text-muted);
      align-self: flex-start;
    }

    .cell-indicators {
      display: flex;
      flex-wrap: wrap;
      gap: 2px;
      justify-content: center;
      align-items: center;
      width: 100%;
      flex: 1;
    }

    .cell-indicators svg {
      width: 11px;
      height: 11px;
    }


    }

    .page-content-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    /* ==========================================
       6. VISTA 1: RUEDA DE LAS ESTACIONES
       ========================================== */
    .wheel-container {
      position: relative;
      width: 100%;
      max-width: 340px;
      aspect-ratio: 1;
    }

    .wheel-svg {
      width: 100%;
      height: 100%;
    }

    .sabbat-node {
      cursor: pointer;
      transition: var(--retro-transition);
    }

    .sabbat-node circle {
      stroke: var(--border-color);
      stroke-width: 1.5;
      transition: var(--retro-transition);
    }

    .sabbat-node:hover circle {
      r: 14;
      stroke: var(--accent-gold-glow);
      stroke-width: 2.5;
      filter: drop-shadow(0 0 4px var(--accent-gold-glow));
    }

    .sabbat-node.selected circle {
      r: 15;
      stroke: var(--accent-gold-glow);
      stroke-width: 3;
      fill: var(--text-main);
    }

    .sabbat-node text {
      font-family: 'Press Start 2P', monospace;
      font-size: 6px;
      fill: var(--text-main);
      pointer-events: none;
      text-anchor: middle;
    }

    .wheel-center-txt {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      fill: var(--text-muted);
      text-anchor: middle;
      pointer-events: none;
    }

    /* ==========================================
       7. VISTA 2: ANILLO DE 28 DÍAS (MENSTRUAL)
       ========================================== */
    .ring-container {
      position: relative;
      width: 100%;
      max-width: 320px;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ring-bead {
      cursor: pointer;
      transition: var(--retro-transition);
    }

    .ring-bead:hover {
      filter: brightness(1.3) drop-shadow(0 0 3px var(--accent-gold-glow));
      transform: scale(1.15);
    }

    .ring-bead.selected {
      stroke: var(--accent-gold-glow);
      stroke-width: 3;
      stroke-dasharray: none;
      filter: drop-shadow(0 0 5px var(--accent-gold-glow));
    }

    .ring-center-panel {
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: var(--bg-darker);
      border: 3px solid var(--border-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px;
      box-shadow: inset 0 0 8px rgba(0,0,0,0.1);
      pointer-events: none;

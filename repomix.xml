    /* ----------------------------------------------------
       Cambio de Vistas Principal
       ---------------------------------------------------- */
    function switchView(viewName, tabEl) {
      if (currentView === viewName) return;
      currentView = viewName;

      // Reproducir sonido de cambio
      audio.playBookFlip();

      // Actualizar pestañas
      document.querySelectorAll('.grimoire-tab').forEach(t => t.classList.remove('active'));
      tabEl.classList.add('active');

      // Actualizar título y contenido del lado izquierdo
      const leftTitle = document.getElementById('left-page-title');
      const leftContent = document.getElementById('left-page-content');

      if (viewName === 'stations') {
        leftTitle.innerHTML = `<span>🌱</span> Rueda de las Estaciones`;
        renderStationsView(leftContent);
      } else if (viewName === 'cycle28') {
        leftTitle.innerHTML = `<span>🔮</span> Anillo de 28 Días`;
        renderCycle28View(leftContent);
      } else if (viewName === 'moon') {
        leftTitle.innerHTML = `<span>🌙</span> Lunación Sinódica`;
        renderMoonView(leftContent);
      } else if (viewName === 'free') {
        leftTitle.innerHTML = `<span>🕯️</span> Registro del Ritual`;
        renderFreeView(leftContent);
      }
    }


    // Vista 2: Anillo de 28 Días
    function renderCycle28View(container) {
      let beadsHtml = '';
      const R = 72; // Radio del anillo
      const cx = 100;
      const cy = 100;

      for (let day = 1; day <= 28; day++) {
        // Encontrar la fase a la que pertenece
        const phase = cyclePhases.find(p => day >= p.range[0] && day <= p.range[1]);

        // Calcular posición en el círculo (partiendo desde las 12 en sentido horario)
        const angle = (day - 1) * (360 / 28) - 90;
        const rad = (angle * Math.PI) / 180;
        const bx = cx + R * Math.cos(rad);
        const by = cy + R * Math.sin(rad);

        const isSelected = day === selectedCycleDay;

        beadsHtml += `
          <circle 
            class="ring-bead ${isSelected ? 'selected' : ''}" 
            cx="${bx}" 
            cy="${by}" 
            r="${isSelected ? 8.5 : 6.5}" 
            fill="${phase.color}" 
            stroke="var(--border-color)" 
            stroke-width="1.5"
            onclick="selectCycleDay(${day})"
          />
        `;
      }

      // Obtener detalles de la fase seleccionada
      const activePhase = cyclePhases.find(p => selectedCycleDay >= p.range[0] && selectedCycleDay <= p.range[1]);

      container.innerHTML = `
        <div class="ring-container">
          <svg viewBox="0 0 200 200" style="width:100%; height:100%;">
            <!-- Fondo orbital -->
            <circle cx="100" cy="100" r="72" fill="none" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="2 2" />
            
            <!-- Gemas del ciclo -->
            ${beadsHtml}
          </svg>
          
          <!-- Cuadro informativo interior -->
          <div class="ring-center-panel">
            <div class="ring-center-day">DÍA ${selectedCycleDay}</div>
            <div class="ring-center-phase" style="color: ${activePhase.color};">${activePhase.name.toUpperCase()}</div>
          </div>
        </div>
        
        <div class="phase-color-legend">
          ${cyclePhases.map(p => `
            <div class="legend-item">
              <span class="legend-dot" style="background-color: ${p.color};"></span>
              <span>${p.name}</span>
            </div>
          `).join('')}
        </div>
      `;

      updateJournalForCycleDay(selectedCycleDay);
    }


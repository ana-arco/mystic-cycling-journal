      margin-bottom: 12px;
    }

    .section-title {
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      color: var(--accent-gold);
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .journal-body {
      font-size: 19px;
      color: var(--text-main);
      line-height: 1.3;
    }

    .journal-stats {
      display: flex;
      gap: 12px;
      margin-top: 8px;
      font-size: 17px;
    }

    .stat-badge {
      background: var(--bg-book);
      border: 1px solid var(--border-color);
      padding: 2px 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* Notas del Grimorio (Formulario) */
    .shadow-notes-form {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      border-top: 2px dashed var(--border-color);
      padding-top: 12px;
    }

    .shadow-notes-textarea {
      width: 100%;
      min-height: 80px;
      background: var(--bg-book);
      border: 2px solid var(--border-color);
      font-family: 'VT323', monospace;
      font-size: 18px;

       10. PÁGINA DERECHA (EL DIARIO / GRIMORIO)
       ========================================== */
    .journal-frame {
      border: 4px double var(--border-color);
      padding: 16px;
      background: var(--bg-darker);
      width: 100%;
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
      border-radius: 2px;

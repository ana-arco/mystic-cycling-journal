      height: 12px;
      border: 2px solid var(--border-color);
      border-radius: 50%;
    }

    /* ==========================================
       8. VISTA 3: CALENDARIO DE LA LUNA
       ========================================== */
    .lunar-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      width: 100%;
      max-width: 380px;
    }

    .lunar-day-card {
      background: var(--bg-darker);
      border: 2px solid var(--border-color);

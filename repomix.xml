    /* ----------------------------------------------------
       Cambio de Vistas Principal
       ---------------------------------------------------- */
    function switchView(viewName, tabEl) {
      if (currentView === viewName) return;
      currentView = viewName;
      
      // Reproducir sonido de cambio
      audio.playBookFlip();
      
      // Actualizar pestañas
      document.querySelectorAll('.grimoire-tab').forEach(t => t.classList.remove('active'));
      tabEl.classList.add('active');
      
      // Actualizar título y contenido del lado izquierdo
      const leftTitle = document.getElementById('left-page-title');
      const leftContent = document.getElementById('left-page-content');
      
      if (viewName === 'stations') {
        leftTitle.innerHTML = `<span>🌱</span> Rueda de las Estaciones`;
        renderStationsView(leftContent);
      } else if (viewName === 'cycle28') {
        leftTitle.innerHTML = `<span>🔮</span> Anillo de 28 Días`;
        renderCycle28View(leftContent);
      } else if (viewName === 'moon') {
        leftTitle.innerHTML = `<span>🌙</span> Lunación Sinódica`;
        renderMoonView(leftContent);
      } else if (viewName === 'free') {
        leftTitle.innerHTML = `<span>🕯️</span> Registro del Ritual`;
        renderFreeView(leftContent);
      }
    }

    /* ----------------------------------------------------
       Renders de las Páginas del Calendario (Página Izquierda)
       ---------------------------------------------------- */
    
    // Vista 1: Rueda de las Estaciones (Sabbats)
    function renderStationsView(container) {
      let nodesHtml = '';
      
      sabbatsData.forEach(s => {
        const isSelected = selectedSabbat === s.id;
        nodesHtml += `
          <g class="sabbat-node ${isSelected ? 'selected' : ''}" 
             data-id="${s.id}" 
             onclick="selectSabbat('${s.id}')">
            <!-- Halo de brillo para seleccionado -->
            ${isSelected ? `<circle cx="${s.x}" cy="${s.y}" r="17" fill="none" stroke="var(--accent-gold-glow)" stroke-width="2" stroke-dasharray="2 2"/>` : ''}
            <!-- Círculo del nodo -->
            <circle cx="${s.x}" cy="${s.y}" r="11" fill="${s.color}"/>
            <circle cx="${s.x}" cy="${s.y}" r="8" fill="var(--bg-book)" opacity="0.3"/>
            <!-- Símbolo de texto -->
            <text x="${s.x}" y="${s.y + 2.5}" font-size="10">${s.symbol}</text>
            <!-- Nombre del Sabbat fuera del nodo -->
            <text x="${s.x}" y="${s.y < 100 ? s.y - 15 : s.y + 20}" font-size="7">${s.name.toUpperCase()}</text>
          </g>
        `;
      });

      container.innerHTML = `
        <div class="wheel-container">
          <svg viewBox="0 0 200 200" class="wheel-svg">
            <!-- Divisiones de las 4 estaciones -->
            <!-- Primavera (Derecha Superior) -->
            <path d="M 100 100 L 100 20 A 80 80 0 0 1 180 100 Z" fill="rgba(93, 180, 104, 0.08)" />
            <!-- Verano (Derecha Inferior) -->
            <path d="M 100 100 L 180 100 A 80 80 0 0 1 100 180 Z" fill="rgba(204, 166, 39, 0.08)" />
            <!-- Otoño (Izquierda Inferior) -->
            <path d="M 100 100 L 100 180 A 80 80 0 0 1 20 100 Z" fill="rgba(176, 84, 45, 0.08)" />
            <!-- Invierno (Izquierda Superior) -->
            <path d="M 100 100 L 20 100 A 80 80 0 0 1 100 20 Z" fill="rgba(58, 127, 156, 0.08)" />

            <!-- Líneas de las estaciones -->
            <line x1="100" y1="18" x2="100" y2="182" stroke="var(--border-color)" stroke-width="2.5" />
            <line x1="18" y1="100" x2="182" y2="100" stroke="var(--border-color)" stroke-width="2.5" />
            
            <!-- Anillo Interior Astrológico -->
            <circle cx="100" cy="100" r="50" fill="none" stroke="var(--border-color)" stroke-dasharray="3 3" stroke-width="1.5" />
            
            <text x="100" y="103" class="wheel-center-txt">RUEDA</text>
            
            <!-- Inyección de los Nodos Sabbat -->
            ${nodesHtml}

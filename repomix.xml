    // Vista 2: Anillo de 28 Días
    function renderCycle28View(container) {
      let beadsHtml = '';
      const R = 72; // Radio del anillo
      const cx = 100;
      const cy = 100;

      for (let day = 1; day <= 28; day++) {
        // Encontrar la fase a la que pertenece
        const phase = cyclePhases.find(p => day >= p.range[0] && day <= p.range[1]);
        
        // Calcular posición en el círculo (partiendo desde las 12 en sentido horario)
        const angle = (day - 1) * (360 / 28) - 90;
        const rad = (angle * Math.PI) / 180;
        const bx = cx + R * Math.cos(rad);
        const by = cy + R * Math.sin(rad);

        const isSelected = day === selectedCycleDay;

        beadsHtml += `
          <circle 
            class="ring-bead ${isSelected ? 'selected' : ''}" 
            cx="${bx}" 
            cy="${by}" 
            r="${isSelected ? 8.5 : 6.5}" 
            fill="${phase.color}" 
            stroke="var(--border-color)" 
            stroke-width="1.5"
            onclick="selectCycleDay(${day})"
          />
        `;
      }

      // Obtener detalles de la fase seleccionada
      const activePhase = cyclePhases.find(p => selectedCycleDay >= p.range[0] && selectedCycleDay <= p.range[1]);

      container.innerHTML = `
        <div class="ring-container">
          <svg viewBox="0 0 200 200" style="width:100%; height:100%;">
            <!-- Fondo orbital -->
            <circle cx="100" cy="100" r="72" fill="none" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="2 2" />
            
            <!-- Gemas del ciclo -->
            ${beadsHtml}
          </svg>
          
          <!-- Cuadro informativo interior -->
          <div class="ring-center-panel">
            <div class="ring-center-day">DÍA ${selectedCycleDay}</div>
            <div class="ring-center-phase" style="color: ${activePhase.color};">${activePhase.name.toUpperCase()}</div>
          </div>
        </div>
        
        <div class="phase-color-legend">
          ${cyclePhases.map(p => `
            <div class="legend-item">
              <span class="legend-dot" style="background-color: ${p.color};"></span>
              <span>${p.name}</span>
            </div>
          `).join('')}
        </div>
      `;

      updateJournalForCycleDay(selectedCycleDay);
    }

    // Vista 3: Ciclo de la Luna (Lunación)
    function renderMoonView(container) {
      let gridHtml = '';
      
      for (let day = 1; day <= 30; day++) {
        // Calcular la fase lunar (0 a 7) para graficar el SVG pixel
        // Dividimos la lunación de 29.5 en 8 fases discretas
        const phasePercentage = ((day - 1) % 29.5) / 29.5;
        const phaseIndex = Math.floor(phasePercentage * 8);
        const isSelected = day === selectedLunarDay;
        
        // Identificar hitos de la lunación
        let isMajor = false;
        let majorLabel = '';
        if (day === 1) { isMajor = true; majorLabel = '🌑'; }
        if (day === 8) { isMajor = true; majorLabel = '🌓'; }
        if (day === 15) { isMajor = true; majorLabel = '🌕'; }
        if (day === 22) { isMajor = true; majorLabel = '🌗'; }

        gridHtml += `
          <div class="lunar-day-card ${isSelected ? 'selected' : ''} ${isMajor ? 'major-phase' : ''}" 
               onclick="selectLunarDay(${day})"
               title="Día Lunar ${day} ${majorLabel}">
            <span class="lunar-day-num">${day}</span>
            <div class="lunar-day-icon">
              ${generateMoonSvg(phaseIndex)}
            </div>
            <span class="lunar-day-num" style="font-size: 6px; color: var(--accent-gold);">${majorLabel}</span>
          </div>
        `;
      }

      container.innerHTML = `
        <div style="font-family:'Press Start 2P', monospace; font-size: 8px; margin-bottom: 12px; text-align: center; color: var(--text-muted);">
          LUNACIÓN COMPLETA (29.5 DÍAS)
        </div>
        <div class="lunar-grid">
          ${gridHtml}
        </div>
      `;

      updateJournalForLunarDay(selectedLunarDay);
    }

    // Algoritmo matemático para dibujar el sprite SVG de la Luna en 16x16
    function generateMoonSvg(phaseIndex, lightColor = 'var(--accent-gold-glow)', shadowColor = 'var(--bg-book)') {
      let illuminatedPart = '';
      
      if (phaseIndex === 0) { // Luna Nueva
        illuminatedPart = '';
      } else if (phaseIndex === 1) { // Creciente Cóncava
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 A 3 7 0 0 1 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 2) { // Cuarto Creciente
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 3) { // Creciente Gibbosa
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 1 8 15 A 3 7 0 0 0 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 4) { // Luna Llena
        illuminatedPart = `<circle cx="8" cy="8" r="7" fill="${lightColor}"/>`;
      } else if (phaseIndex === 5) { // Menguante Gibbosa
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 A 3 7 0 0 1 8 1 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 6) { // Cuarto Menguante
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 Z" fill="${lightColor}"/>`;
      } else if (phaseIndex === 7) { // Menguante Cóncava
        illuminatedPart = `<path d="M 8 1 A 7 7 0 0 0 8 15 A 3 7 0 0 0 8 1 Z" fill="${lightColor}"/>`;
      }

      return `
        <svg viewBox="0 0 16 16" width="100%" height="100%" class="pixel-icon">
          <circle cx="8" cy="8" r="7" fill="${shadowColor}" opacity="0.45"/>
          ${illuminatedPart}
        </svg>
      `;
    }

    // Vista 4: Selección Libre (Grid del Ritual)
    function renderFreeView(container) {
      let cellsHtml = '';
      
      // 35 celdas para representar un tablero del mes
      for (let cell = 1; cell <= 35; cell++) {
        const cellData = savedFreeGrid[cell] || {};
        let iconsHtml = '';
        
        // Agregar iconos pixel de los estados guardados
        if (cellData.blood) iconsHtml += PIXEL_SVGS.blood;
        if (cellData.fire) iconsHtml += PIXEL_SVGS.fire;
        if (cellData.candle) iconsHtml += PIXEL_SVGS.candle;
        if (cellData.star) iconsHtml += PIXEL_SVGS.star;
        
        const isSelected = cell === selectedFreeDay;

        cellsHtml += `
          <div class="grid-cell ${isSelected ? 'selected' : ''}" 
               data-cell="${cell}"
               onmousedown="handleCellMouseDown(${cell}, event)"
               onmouseenter="handleCellMouseEnter(${cell})"
               title="Día del Registro ${cell}">
            <span class="cell-number">${cell}</span>
            <div class="cell-indicators">
              ${iconsHtml}
            </div>
          </div>
        `;
      }

      container.innerHTML = `
        <div class="free-selection-container">
          <div style="font-family:'Press Start 2P', monospace; font-size: 8px; margin-bottom: 8px; text-align: center; color: var(--text-muted);">
            PINCEL DE ENERGÍA Y SÍNTOMAS
          </div>
          
          <!-- Herramientas del Pintor -->
          <div class="toolbox">
            <button class="tool-btn ${activeTool === 'blood' ? 'active' : ''}" onclick="selectTool('blood')" title="Registrar Sangrado (Gota)">
              ${PIXEL_SVGS.blood}
            </button>
            <button class="tool-btn ${activeTool === 'fire' ? 'active' : ''}" onclick="selectTool('fire')" title="Registrar Cólicos o Dolor (Fuego)">
              ${PIXEL_SVGS.fire}
            </button>
            <button class="tool-btn ${activeTool === 'candle' ? 'active' : ''}" onclick="selectTool('candle')" title="Registrar Ritual o Meditación (Vela)">
              ${PIXEL_SVGS.candle}
            </button>
            <button class="tool-btn ${activeTool === 'star' ? 'active' : ''}" onclick="selectTool('star')" title="Registrar Energía Alta (Estrella)">
              ${PIXEL_SVGS.star}
            </button>
            <button class="tool-btn ${activeTool === 'broom' ? 'active' : ''}" onclick="selectTool('broom')" title="Borrador de Estados">
              ${PIXEL_SVGS.broom}
            </button>
          </div>
          
          <div class="paint-grid" id="drag-grid">
            ${cellsHtml}
          </div>
          
          <p style="font-size: 15px; color: var(--text-muted); margin-top: 10px; text-align: center;">
            Haz clic y arrastra con el ratón para pintar estados en múltiples días.
          </p>
        </div>
      `;

      // Escuchadores de fin de dibujo
      const grid = document.getElementById('drag-grid');
      grid.addEventListener('mouseup', () => { isDrawing = false; });
      grid.addEventListener('mouseleave', () => { isDrawing = false; });
      
      updateJournalForFreeDay(selectedFreeDay);
    }

    function selectTool(toolName) {
      audio.playClick();
      activeTool = toolName;
      document.querySelectorAll('.tool-btn').forEach(btn => btn.classList.remove('active'));
      event.currentTarget.classList.add('active');
    }

    /* ----------------------------------------------------
       Lógica de Pintura y Arrastre (Drag and Paint)
       ---------------------------------------------------- */
    function handleCellMouseDown(cellNum, e) {
      e.preventDefault();
      isDrawing = true;
      audio.playClick();
      selectedFreeDay = cellNum;
      
      // Aplicar el estado de la herramienta
      applyToolToCell(cellNum);
      
      // Volver a renderizar para ver seleccionados y cambios
      renderFreeView(document.getElementById('left-page-content'));
    }

    function handleCellMouseEnter(cellNum) {
      if (isDrawing) {
        applyToolToCell(cellNum);
        renderFreeView(document.getElementById('left-page-content'));
      }
    }

    function applyToolToCell(cellNum) {
      if (!savedFreeGrid[cellNum]) {
        savedFreeGrid[cellNum] = { blood: false, fire: false, candle: false, star: false };
      }

      if (activeTool === 'broom') {
        // Borrar todo
        savedFreeGrid[cellNum] = { blood: false, fire: false, candle: false, star: false };
      } else {
        // Alternar el estado seleccionado
        savedFreeGrid[cellNum][activeTool] = !savedFreeGrid[cellNum][activeTool];
      }

      // Guardar en almacenamiento local
      localStorage.setItem('savedFreeGrid', JSON.stringify(savedFreeGrid));
    }

    /* ----------------------------------------------------
       Selección de Elementos de los Calendarios
       ---------------------------------------------------- */
    function selectSabbat(id) {
      audio.playShimmer();
      selectedSabbat = id;
      
      // Actualizar vista izquierda para marcar el seleccionado
      renderStationsView(document.getElementById('left-page-content'));
    }

    function selectCycleDay(dayNum) {
      audio.playClick();
      selectedCycleDay = dayNum;
      renderCycle28View(document.getElementById('left-page-content'));
    }

    function selectLunarDay(dayNum) {
      audio.playClick();
      selectedLunarDay = dayNum;
      renderMoonView(document.getElementById('left-page-content'));
    }


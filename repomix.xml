        <div class="subtitle">Visión Estratégica, Manifiesto de Soberanía e Hitos de Ruta</div>
    </header>

    <div class="grimorio-book">
        <!-- Pestañas Interactivas -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchPage('vision', this)">1. MANIFIESTO Y VISIÓN</button>

    .tool-btn:hover {
      background: var(--bg-book);
      transform: translateY(-2px);
    }

    .tool-btn.active {
      background: var(--accent-gold);
      border-color: var(--accent-gold-glow);
      box-shadow: 0 0 6px var(--accent-gold-glow);
    }


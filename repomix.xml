  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================
       1. VARIABLES Y SISTEMA DE TEMAS (CSS VARIABLES)
       ========================================== */
    :root {
      /* Tema por defecto: Pergamino Cozy */
      --bg-page: #d4c5a1; /* Fondo cálido madera/mesa */
      --bg-book: #f4eccf; /* Pergamino claro */
      --bg-darker: #e2d7b2; /* Pergamino sombreado */
      --text-main: #3c2a1a; /* Marrón oscuro cuero */
      --text-muted: #7d5c41; /* Marrón medio */
      --border-color: #2e1d11; /* Borde oscuro pixel */
      
      --accent-gold: #b3861b;

    [data-theme="stone"] body {
      background-image: radial-gradient(var(--accent-purple) 1px, transparent 1px);
    }

    h1, h2, h3, h4 {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      letter-spacing: 1px;
    }

    /* ==========================================
       3. DISEÑO PIXEL ART UTILS
       ========================================== */

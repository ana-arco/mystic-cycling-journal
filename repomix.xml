      --accent-red: #a32e2e;
      --accent-green: #3b7e46;
      --accent-purple: #5c2d7a;
      
      --shadow-color: rgba(46, 29, 17, 0.25);
      
      /* Animaciones */
      --retro-transition: all 0.15s steps(4);
    }

    [data-theme="stone"] {
      /* Tema Alternativo: Piedra Arcana Nocturna */
      --bg-page: #0f0a18; /* Espacio exterior / calabozo oscuro */
      --bg-book: #1f182c; /* Piedra oscura */
      --bg-darker: #150f1f; /* Huecos oscuros */
      --text-main: #e6dbf3; /* Lilac luminoso */
      --text-muted: #8d79a5; /* Morado apagado */
      --border-color: #45355c; /* Borde runa */
      
      --accent-gold: #f4be37;
      --accent-gold-glow: #ffee7d;
      --accent-red: #f34b4b;
      --accent-green: #4ade80;
      --accent-purple: #a855f7;
      
      --shadow-color: rgba(0, 0, 0, 0.6);
    }

    /* ==========================================
       2. REGLAS GENERALES Y RESET
       ========================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      image-rendering: pixelated;
    }

    body {
      background-color: var(--bg-page);
      font-family: 'VT323', monospace;
      color: var(--text-main);
      font-size: 20px;
      line-height: 1.4;
      padding: 20px;

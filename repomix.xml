    /* ==========================================
       9. VISTA 4: SELECCIÓN LIBRE (PAINT GRID)
       ========================================== */
    .free-selection-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 420px;
